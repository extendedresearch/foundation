  "id": "0006-a-browser-host-id-is-its-epoch-and-keeps-no-suffix",
  "about": "The browser domain's host_id and host_clock_epoch are both doc_epoch_from(nonce_hi, nonce_lo) for one realm nonce. DriftCheck ends the domain by replacing the epoch's suffix, and leaves host_id as it was: the realm does not change at a discontinuity. The clock is a two-sided engine with q = 100 us, so each monotonic reading is bounded (q, q); Date.now is floor-only at 1 ms. Observation 0 fires, against the start anchor: before is then the anchor's monotonic_ns on the ending domain, bounded by the anchor's error, ceil(s/2) + mono late + wall early and floor(s/2) + mono early + wall late, with basis ClockRead (9). Observation 1 is quiet on .e1, and observation 2 fires again, to .e2, with host_id unchanged. A face that suffixes host_id, appends .e1.e2, bounds before by the reading's own bound, or reports before as zero width fails a row.",
  "function": "DriftCheck",
  "faces": [
    "browser"
  ],
  "nonce": {
    "nonce_hi": 0,
    "nonce_lo": 171
  },
  "domain": {
    "resolution_ns": "100000"
  },
  "monotonic_rounding": "two_sided",
