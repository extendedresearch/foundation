      },
      "expect": {
        "unix_ns": "1699999999000000005",
        "early_ns": "18446744073709551615",
        "late_ns": "18446744073709551615"
      }
    },
    "unbounded_reading": {
      "input": {
        "reading": {
          "ns": "5",
          "early_ns": "18446744073709551615",
          "late_ns": "0",
          "basis": 9
        },
        "monotonic_rounding": "floor_only"
      },
      "expect": {
        "unix_ns": "1699999999000000005",
