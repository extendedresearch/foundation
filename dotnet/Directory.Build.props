<!-- Adopted from extendedresearch/foundation style/configs/Directory.Build.props.
     S28, S31. Place at the root of a repository's .NET tree; every project
     under it inherits these. `style/scripts/check-configs.py` checks the copy.

     **Two settings are deliberately absent, and their absence is the rule.**

     `AnalysisMode` is left at its default rather than raised to `Recommended`.
     A repository that already sets `TreatWarningsAsErrors` turns every
     recommended-tier suggestion into a build error the day it adopts this file
     — one real adoption produced twelve, across four rules, in code nobody was
     changing. That is the opposite of how every other language in the guide is
     adopted: soft first, scoped to what a change touches, strict when the tree
     is already clean. A repository raises `AnalysisMode` itself, deliberately,
     when that is true of its tree.

     `GenerateDocumentationFile` is a packaging concern, not a style baseline.
     Turned on here it applies to test projects too, where it makes CS1591
     fatal on every public test method — documentation nobody reads, enforced
     on code that ships to nobody. A library that ships sets it in its own
     project file, which is also where the decision belongs. -->
<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors></WarningsNotAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
